rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isParticipant(cid) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants;
    }

    // ── Users ─────────────────────────────────────────────────────────────────
    // Flutter login writes users/{uid}; owner + admins can read/write.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // ── Listings ──────────────────────────────────────────────────────────────
    // All authenticated users can read active listings.
    // Writes go through the Python backend (Admin SDK bypasses these rules).
    match /listings/{listingId} {
      allow read: if isSignedIn();
      allow write: if false; // backend only
    }

    // ── Buyer Rates ───────────────────────────────────────────────────────────
    match /rates/{rateId} {
      allow read: if isSignedIn();
      allow write: if false; // backend only
    }

    // ── Chat ─────────────────────────────────────────────────────────────────
    // Client can READ live for real-time snapshot listeners.
    // All WRITES go through the Python backend.
    match /conversations/{cid} {
      allow read: if isParticipant(cid);
      allow write: if false;

      match /messages/{mid} {
        allow read: if isParticipant(cid);
        allow write: if false;
      }
    }

    // ── Forum Posts ───────────────────────────────────────────────────────────
    // All authenticated users can read; writes go through backend.
    match /forum_posts/{postId} {
      allow read: if isSignedIn() && resource.data.is_deleted == false;
      allow write: if false;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ── Weather Alerts ────────────────────────────────────────────────────────
    // All authenticated users can read active alerts (real-time listener).
    match /weather_alerts/{alertId} {
      allow read: if isSignedIn() && resource.data.active == true;
      allow write: if false;
    }

    // ── Agricultural Advisory (read-only for authenticated users) ─────────────
    match /diseases/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /tips/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /machinery/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /news/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ── Everything else: backend only ─────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
