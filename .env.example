# ============================================================
# Krishi Connect Backend – Environment Configuration
# ============================================================

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=*

# ============================================================
# DEV MODE  (local, in-memory, no Firebase needed)
# ============================================================
# USE_FIREBASE=false  -> SQLite-like in-memory DB (data lost on restart)
# AUTH_DISABLED=true  -> "Authorization: Bearer <any-uid>" accepted as-is
#                        NEVER use in production!
USE_FIREBASE=false
AUTH_DISABLED=true

# ============================================================
# PRODUCTION MODE (Firestore + Firebase Auth token verification)
# ============================================================
# Step 1: Enable Firebase
# USE_FIREBASE=true
# AUTH_DISABLED=false

# Step 2: Provide Firebase credentials (choose ONE method)
#
# Method A – JSON file path (for local / VPS where you can upload files)
# FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
#
# Method B – Inline JSON string (recommended for Render.com / Railway / Heroku)
# Copy the entire contents of serviceAccountKey.json and paste it as one line:
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"krishi-connect-9ca73",...}

# Step 3: Firebase Storage bucket (required for image uploads)
# FIREBASE_STORAGE_BUCKET=krishi-connect-9ca73.firebasestorage.app

MAX_UPLOAD_MB=5
