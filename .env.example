# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=*

# --- Dev mode (Firebase chhara local-e chalate chaile) ---
# USE_FIREBASE=false  -> in-memory database (restart dile data jabe)
# AUTH_DISABLED=true  -> "Authorization: Bearer <any-uid>" dile hobe (shudhu development-e!)
USE_FIREBASE=false
AUTH_DISABLED=true

# --- Production (Firebase) ---
# USE_FIREBASE=true
# AUTH_DISABLED=false
# FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
MAX_UPLOAD_MB=5
