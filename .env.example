# ============================================================
# Krishi Connect Backend – Environment Configuration v2
# ============================================================

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=*

# ============================================================
# DEV MODE  (local, SQLite, no Firebase needed)
# ============================================================
# USE_FIREBASE=false  → SQLite DB (data persisted in krishi.db)
# AUTH_DISABLED=true  → "Authorization: Bearer <any-uid>" accepted as-is
#                       NEVER use in production!
USE_FIREBASE=false
AUTH_DISABLED=true

# Admin UIDs: comma-separated Firebase UIDs that auto-get admin role
# In dev mode (AUTH_DISABLED=true), use any bearer token value as the UID.
# Example: set ADMIN_UIDS=admin123 then call API with "Bearer admin123"
ADMIN_UIDS=admin123

# ============================================================
# PRODUCTION MODE (Firestore + Firebase Auth token verification)
# ============================================================
# Step 1: Enable Firebase
# USE_FIREBASE=true
# AUTH_DISABLED=false

# Step 2: Provide Firebase credentials (choose ONE method)
#
# Method A – JSON file path (for local / VPS where you can upload files)
# FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json
#
# Method B – Inline JSON string (recommended for Render.com / Railway / Heroku)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"krishi-connect-9ca73",...}

# Step 3: Firebase Storage bucket (required for image uploads via backend)
# FIREBASE_STORAGE_BUCKET=krishi-connect-9ca73.firebasestorage.app

# Step 4: Admin UIDs (Firebase UIDs of admin accounts)
# ADMIN_UIDS=uid1,uid2,uid3

MAX_UPLOAD_MB=5
